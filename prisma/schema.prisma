generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // hashed
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  tickets       Ticket[]
  posts         Post[]
  comments      Comment[]
  tournamentRegistrations TournamentRegistration[]
}

model Tournament {
  id          String   @id @default(cuid())
  title       String
  game        String
  description String
  startDate   DateTime
  endDate     DateTime
  prizePool   Float
  ticketPrice Float
  imageUrl    String?
  status      TournamentStatus @default(UPCOMING)
  tickets     Ticket[]
  registrations TournamentRegistration[]
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  tournamentId String
  purchaseDate DateTime @default(now())
  stripePaymentIntentId String? // for verification
  user        User     @relation(fields: [userId], references: [id])
  tournament  Tournament @relation(fields: [tournamentId], references: [id])
}

model TournamentRegistration {
  id          String   @id @default(cuid())
  userId      String
  tournamentId String
  registeredAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  tournament  Tournament @relation(fields: [tournamentId], references: [id])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // for white-label subdomain or path
  logo        String?
  primaryColor String?  // hex code for branding
  createdAt   DateTime @default(now())
  users       OrganizationUser[]
  events      Event[]   // events created by this org
  tickets     Ticket[]  // all tickets sold via this org
}

model OrganizationUser {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER) // ADMIN, MEMBER
  user           User     @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum OrgRole {
  ADMIN
  MEMBER
}

// Extend existing Event model (rename Tournament → Event for generalization)
model Event {
  id             String   @id @default(cuid())
  title          String
  description    String
  startDate      DateTime
  endDate        DateTime
  ticketPrice    Float
  totalTickets   Int?     // optional capacity
  soldTickets    Int      @default(0)
  imageUrl       String?
  status         EventStatus @default(DRAFT)
  organizationId String   // new: which org owns this event
  organization   Organization @relation(fields: [organizationId], references: [id])
  tickets        Ticket[]
  registrations  TournamentRegistration[] // if also has brackets
  createdAt      DateTime @default(now())
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
}

// Update existing Ticket model to reference Event (instead of Tournament)
// Keep backward compatibility by renaming tournamentId → eventId
model Ticket {
  id          String   @id @default(cuid())
  userId      String
  eventId     String   // changed from tournamentId
  organizationId String // denormalized for quick filtering
  purchaseDate DateTime @default(now())
  stripePaymentIntentId String?
  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}
