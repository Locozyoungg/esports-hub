generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String    // hashed; empty string for guest checkout users
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())

  tickets                 Ticket[]
  posts                   Post[]
  comments                Comment[]
  tournamentRegistrations TournamentRegistration[]
  organizations           OrganizationUser[]
  orders                  Order[]
}

enum UserRole {
  USER
  ADMIN
}

// ── Tournaments (competitive events with brackets / prizes) ───────

model Tournament {
  id          String           @id @default(cuid())
  title       String
  game        String
  description String
  startDate   DateTime
  endDate     DateTime
  prizePool   Float
  ticketPrice Float
  imageUrl    String?
  status      TournamentStatus @default(UPCOMING)

  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id])
  registrations TournamentRegistration[]
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
}

model TournamentRegistration {
  id           String   @id @default(cuid())
  userId       String
  tournamentId String
  registeredAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([userId, tournamentId])
}

// ── Organizations (white-label event hosts) ────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logo         String?
  primaryColor String?
  mpesaPaybill String?  // M-Pesa PayBill number (e.g. "247247")
  mpesaAccountPrefix String? // Prefix for account ref (e.g. "ESH-")
  createdAt    DateTime @default(now())

  users   OrganizationUser[]
  events  Event[]
  tickets Ticket[]
}

model OrganizationUser {
  id             String          @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole         @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum OrgRole {
  ADMIN
  MEMBER
}

// ── Events (ticketed experiences under an organization) ────────────

model Event {
  id             String      @id @default(cuid())
  title          String
  description    String
  startDate      DateTime
  endDate        DateTime
  ticketPrice    Float
  totalTickets   Int?
  soldTickets    Int         @default(0)
  imageUrl       String?
  status         EventStatus @default(DRAFT)
  organizationId String
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]
  tournaments  Tournament[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
}

// ── Tickets (purchased via Stripe) ─────────────────────────────────

model Ticket {
  id                     String   @id @default(cuid())
  userId                 String
  eventId                String
  organizationId         String
  purchaseDate           DateTime @default(now())
  stripePaymentIntentId  String?

  user         User         @relation(fields: [userId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

// ── Community ──────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id])
}

// ── Shop / Merchandise ──────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float                        // KES
  category    ProductCategory
  imageUrl    String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

enum ProductCategory {
  GAMING_GEAR
  APPAREL
  ACCESSORIES
  OTHER
}

// ── Orders ──────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  userId           String
  totalAmount      Float                                   // KES
  status           OrderStatus @default(PENDING)
  stripePaymentId  String?
  shippingAddress  String?
  shippingCity     String?
  shippingPhone    String?
  customerName     String?
  customerEmail    String?
  createdAt        DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  unitPrice Float                           // KES at time of purchase

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ── Analytics ────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  timestamp DateTime @default(now())
}

model SaleMetric {
  id          String   @id @default(cuid())
  type        String                        // 'ticket' | 'merchandise' | 'mpesa' | 'card'
  amount      Float                        // KES
  description String?
  userId      String?
  timestamp   DateTime @default(now())
}